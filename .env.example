DB_PORT=3306
DB_USER=root
DB_PASSWORD=Singh5322f
DB_NAME=quickcart_db
DB_SSL=false

# Authentication
JWT_SECRET=quickcart_secret_key_aws_3tier_2026
JWT_EXPIRES_IN=7d
