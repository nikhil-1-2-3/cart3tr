# QuickCart Terraform Deployment Variables Example
# Copy to terraform.tfvars and customize with your own values:
# cp terraform.tfvars.example terraform.tfvars

aws_region   = "us-east-1"
project_name = "quickcart"
environment  = "dev"

# Database Configuration
db_username = "admin"
db_password = "YourStrongPassword123!" # Replace with your secure password

# Backend Docker / Git Settings
# Option A: If you pushed your backend to Docker Hub, specify it here:
# docker_image = "yourdockerhubusername/quickcart-backend:latest"

# Option B: If building from Git repository:
git_repo_url = "https://github.com/nikhil-singh/quickcart.git"

# High Availability Configuration
instance_type        = "t3.micro"
asg_min_size         = 1
asg_max_size         = 3
asg_desired_capacity = 2
