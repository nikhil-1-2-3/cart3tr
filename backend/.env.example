# QuickCart Backend Environment Configuration

# Server Port (default 5001)
PORT=5001

# Node Environment ('development' or 'production')
NODE_ENV=development

# Database Configuration (Compatible with Local MySQL & Amazon RDS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=quickcart_db

# Enable SSL for Amazon RDS connection (set to 'true' in production on AWS)
DB_SSL=false

# Allowed Frontend URL for CORS (e.g., http://localhost:5173 or https://quickcart.vercel.app)
CLIENT_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
